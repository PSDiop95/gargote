    m_Localized: "Doigts de f\xE9e"
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703473
    m_Localized: "B\xE2tisseur"
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703474
    m_Localized: La rue s'anime
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703475
    m_Localized: Bon patron
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703476
    m_Localized: Plus vite !
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703477
    m_Localized: "Bien \xE9quip\xE9"
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703478
    m_Localized: Recommencer en mieux
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703479
    m_Localized: Teranga absolue
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703480
    m_Localized: Tour de l'Afrique de l'Ouest
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703481
    m_Localized: Chasseur de coffres
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703482
    m_Localized: Collectionneur
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703483
    m_Localized: Talents rares
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703484
