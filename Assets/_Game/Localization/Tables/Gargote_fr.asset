  - m_Id: 2445058048
    m_Localized: Forokh Thiaya
    m_Metadata:
      m_Items: []
  - m_Id: 2562498560
    m_Localized: "Tangana / Nd\xE9ki"
    m_Metadata:
      m_Items: []
  - m_Id: 2562498561
    m_Localized: "Ma\xEFga"
    m_Metadata:
      m_Items: []
  - m_Id: 2562498562
    m_Localized: Gargote
    m_Metadata:
      m_Items: []
  - m_Id: 2562498563
    m_Localized: Dibiterie
    m_Metadata:
      m_Items: []
  - m_Id: 2562498564
    m_Localized: Fataya & Nems
    m_Metadata:
      m_Items: []
  - m_Id: 2562498565
    m_Localized: Restaurant Teranga
    m_Metadata:
      m_Items: []
  - m_Id: 2562498566
    m_Localized: "Traiteur \xC9v\xE9nements"
    m_Metadata:
      m_Items: []
  - m_Id: 2562498567
    m_Localized: Pain chaud, viande chaude, client content !
    m_Metadata:
      m_Items: []
  - m_Id: 2562498568
    m_Localized: Ma brouette, c'est mon bureau.
    m_Metadata:
      m_Items: []
  - m_Id: 2562498569
    m_Localized: "J\xEBr\xEBj\xEBf, \xE0 demain !"
    m_Metadata:
      m_Items: []
  - m_Id: 2562498570
    m_Localized: "Le caf\xE9 Touba est pr\xEAt !"
    m_Metadata:
      m_Items: []
  - m_Id: 2562498571
    m_Localized: "Omelette ou ni\xE9b\xE9 ? Les deux, bien s\xFBr."
    m_Metadata:
      m_Items: []
  - m_Id: 2562498572
    m_Localized: Le matin, ici, c'est la meilleure adresse.
    m_Metadata:
      m_Items: []
  - m_Id: 2562498573
    m_Localized: La nuit est jeune, les brochettes aussi !
    m_Metadata:
      m_Items: []
  - m_Id: 2562498574
    m_Localized: Sous l'ampoule, tout est plus bon.
    m_Metadata:
      m_Items: []
  - m_Id: 2562498575
    m_Localized: Une petite faim ? On a ce qu'il faut.
    m_Metadata:
      m_Items: []
  - m_Id: 2562498576
    m_Localized: "Le thi\xE9b' du jour sort de la marmite !"
    m_Metadata:
      m_Items: []
  - m_Id: 2562498577
    m_Localized: Assieds-toi, mange, c'est la maison.
    m_Metadata:
      m_Items: []
  - m_Id: 2562498578
    m_Localized: "Le secret ? La patience\u2026 et le riz cass\xE9."
    m_Metadata:
      m_Items: []
  - m_Id: 2562498579
    m_Localized: "Le dibi est grill\xE9 \xE0 point."
    m_Metadata:
      m_Items: []
  - m_Id: 2562498580
    m_Localized: "Oignons, moutarde, et le tour est jou\xE9 !"
    m_Metadata:
      m_Items: []
  - m_Id: 2562498581
    m_Localized: Le charbon chante, c'est bon signe.
    m_Metadata:
      m_Items: []
  - m_Id: 2562498582
    m_Localized: Fatayas tout chauds, attention les doigts !
    m_Metadata:
      m_Items: []
  - m_Id: 2562498583
    m_Localized: 'Pastels, nems, fatayas : on a tout.'
    m_Metadata:
      m_Items: []
  - m_Id: 2562498584
    m_Localized: Un pour toi, un pour la route.
    m_Metadata:
      m_Items: []
  - m_Id: 2562498585
    m_Localized: Bienvenue chez nous, la Teranga d'abord !
    m_Metadata:
      m_Items: []
  - m_Id: 2562498586
    m_Localized: Table pour combien ?
    m_Metadata:
      m_Items: []
  - m_Id: 2562498587
    m_Localized: "Le dessert est offert\u2026 aux habitu\xE9s."
    m_Metadata:
      m_Items: []
  - m_Id: 2562498588
    m_Localized: "Trois cents invit\xE9s ? Pas de souci."
    m_Metadata:
      m_Items: []
  - m_Id: 2562498589
    m_Localized: Les marmites sont en route !
    m_Metadata:
      m_Items: []
  - m_Id: 2562498590
    m_Localized: "Une f\xEAte r\xE9ussie, \xE7a se mange."
    m_Metadata:
      m_Items: []
  - m_Id: 2562498591
    m_Localized: "Fonctionnaire press\xE9"
    m_Metadata:
      m_Items: []
  - m_Id: 2562498592
    m_Localized: Touriste perdu
    m_Metadata:
      m_Items: []
  - m_Id: 2562498593
    m_Localized: "Lutteur affam\xE9"
    m_Metadata:
      m_Items: []
  - m_Id: 2562498594
    m_Localized: "D\xE9l\xE9gation de mariage"
    m_Metadata:
      m_Items: []
  - m_Id: 2562498595
    m_Localized: /s
    m_Metadata:
      m_Items: []
  - m_Id: 2562498596
    m_Localized: 'Objectif Dakar :'
    m_Metadata:
      m_Items: []
