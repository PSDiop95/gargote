    m_Metadata:
      m_Items: []
  - m_Id: 2562498612
    m_Localized: "Bient\xF4t disponible"
    m_Metadata:
      m_Items: []
  - m_Id: 2562498613
    m_Localized: OUVERT !
    m_Metadata:
      m_Items: []
  - m_Id: 2562498614
    m_Localized: VITESSE x2 !
    m_Metadata:
      m_Items: []
  - m_Id: 2562498615
    m_Localized: REVENUS x2 !
    m_Metadata:
      m_Items: []
  - m_Id: 2562498616
    m_Localized: TOUTE LA RUE x1,25 !
    m_Metadata:
      m_Items: []
  - m_Id: 2562498617
    m_Localized: "Pendant ton absence\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 2562498618
    m_Localized: Absent
    m_Metadata:
      m_Items: []
