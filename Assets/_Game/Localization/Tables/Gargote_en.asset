  m_TableData:
  - m_Id: 2445058048
    m_Localized: Forokh Thiaya
    m_Metadata:
      m_Items: []
  - m_Id: 2562498560
    m_Localized: Tangana / Ndeki
    m_Metadata:
      m_Items: []
  - m_Id: 2562498561
    m_Localized: Maiga
    m_Metadata:
      m_Items: []
  - m_Id: 2562498562
    m_Localized: Gargote
    m_Metadata:
      m_Items: []
  - m_Id: 2562498563
    m_Localized: Dibiterie
    m_Metadata:
      m_Items: []
  - m_Id: 2562498564
    m_Localized: Fataya & Nems
    m_Metadata:
      m_Items: []
  - m_Id: 2562498565
    m_Localized: Teranga Restaurant
    m_Metadata:
      m_Items: []
  - m_Id: 2562498566
    m_Localized: Event Caterer
    m_Metadata:
      m_Items: []
  - m_Id: 2562498567
    m_Localized: Hot bread, hot meat, happy customer!
    m_Metadata:
      m_Items: []
  - m_Id: 2562498568
    m_Localized: My cart is my office.
    m_Metadata:
      m_Items: []
  - m_Id: 2562498569
    m_Localized: "J\xEBr\xEBj\xEBf, see you tomorrow!"
    m_Metadata:
      m_Items: []
  - m_Id: 2562498570
    m_Localized: The Touba coffee is ready!
    m_Metadata:
      m_Items: []
  - m_Id: 2562498571
    m_Localized: Omelette or beans? Both, of course.
    m_Metadata:
      m_Items: []
  - m_Id: 2562498572
    m_Localized: Mornings, this is the place to be.
    m_Metadata:
      m_Items: []
  - m_Id: 2562498573
    m_Localized: The night is young, so are the skewers!
    m_Metadata:
      m_Items: []
  - m_Id: 2562498574
    m_Localized: Under the bulb, everything tastes better.
    m_Metadata:
      m_Items: []
  - m_Id: 2562498575
    m_Localized: A little hungry? We've got you.
    m_Metadata:
      m_Items: []
  - m_Id: 2562498576
    m_Localized: Today's thieb is out of the pot!
    m_Metadata:
      m_Items: []
  - m_Id: 2562498577
    m_Localized: Sit down, eat, you're home.
    m_Metadata:
      m_Items: []
  - m_Id: 2562498578
    m_Localized: "The secret? Patience\u2026 and broken rice."
    m_Metadata:
      m_Items: []
  - m_Id: 2562498579
    m_Localized: The dibi is grilled just right.
    m_Metadata:
      m_Items: []
  - m_Id: 2562498580
    m_Localized: Onions, mustard, and you're set!
    m_Metadata:
      m_Items: []
  - m_Id: 2562498581
    m_Localized: The charcoal is singing, good sign.
    m_Metadata:
      m_Items: []
  - m_Id: 2562498582
    m_Localized: Hot fatayas, mind your fingers!
    m_Metadata:
      m_Items: []
  - m_Id: 2562498583
    m_Localized: 'Pastels, nems, fatayas: we have it all.'
    m_Metadata:
      m_Items: []
  - m_Id: 2562498584
    m_Localized: One for you, one for the road.
    m_Metadata:
      m_Items: []
  - m_Id: 2562498585
    m_Localized: Welcome, hospitality comes first!
    m_Metadata:
      m_Items: []
  - m_Id: 2562498586
    m_Localized: Table for how many?
    m_Metadata:
      m_Items: []
  - m_Id: 2562498587
    m_Localized: "Dessert is on us\u2026 for regulars."
    m_Metadata:
      m_Items: []
  - m_Id: 2562498588
    m_Localized: Three hundred guests? No problem.
    m_Metadata:
      m_Items: []
  - m_Id: 2562498589
    m_Localized: The pots are on their way!
    m_Metadata:
      m_Items: []
  - m_Id: 2562498590
    m_Localized: A good party is one you can eat.
    m_Metadata:
      m_Items: []
  - m_Id: 2562498591
    m_Localized: Hurried Official
    m_Metadata:
      m_Items: []
  - m_Id: 2562498592
