    m_Metadata:
      m_Items: []
  - m_Id: 708215796703496
    m_Localized: Collier de cauris
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703497
    m_Localized: Toute la rue avance
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703498
    m_Localized: "\xC7a tourne sans moi"
    m_Metadata:
