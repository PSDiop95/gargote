    m_Metadata:
      m_Items: []
  - m_Id: 708215796703485
    m_Localized: "L\xE9gende de la rue"
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703486
    m_Localized: "\xC9cole des g\xE9rants"
    m_Metadata:
      m_Items: []
