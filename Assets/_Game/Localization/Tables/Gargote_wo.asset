  - m_Id: 708215792509090
    m_Localized: Relance {0} fois
    m_Metadata:
      m_Items: []
  - m_Id: 708215792509091
    m_Localized: "Gagne {0} \xE9toiles"
    m_Metadata:
      m_Items: []
  - m_Id: 708215792509092
    m_Localized: Visite {0} villes
    m_Metadata:
      m_Items: []
  - m_Id: 708215792509093
    m_Localized: Ouvre {0} coffres
    m_Metadata:
      m_Items: []
  - m_Id: 708215792509094
    m_Localized: "Poss\xE8de {0} g\xE9rants"
    m_Metadata:
      m_Items: []
  - m_Id: 708215792509095
    m_Localized: "Poss\xE8de {0} g\xE9rants rares"
    m_Metadata:
      m_Items: []
  - m_Id: 708215792509096
    m_Localized: "Poss\xE8de {0} g\xE9rants \xE9piques"
    m_Metadata:
      m_Items: []
  - m_Id: 708215792509097
    m_Localized: "Poss\xE8de {0} g\xE9rants l\xE9gendaires"
    m_Metadata:
      m_Items: []
  - m_Id: 708215792509098
    m_Localized: "Gagne {0} niveaux de g\xE9rant"
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703232
    m_Localized: Termine {0} missions
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703233
    m_Localized: "Termine {0} d\xE9fis du jour"
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703234
    m_Localized: "S\xE9rie de {0} jours"
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703235
    m_Localized: Connecte-toi {0} jours
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703236
    m_Localized: Tourne la roue {0} fois
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703237
    m_Localized: "Sers {0} clients sp\xE9ciaux"
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703238
    m_Localized: Lance {0} boosts
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703239
    m_Localized: "D\xE9couvre {0} recettes"
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703240
    m_Localized: Atteins le niveau {0}
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703241
    m_Localized: Gagne {0} cauris
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703242
    m_Localized: Atteins {0} paliers de rue
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703243
    m_Localized: "R\xE9cup\xE8re {0} fois tes gains hors ligne"
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703244
    m_Localized: "Regarde {0} pubs r\xE9compens\xE9es"
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703245
    m_Localized: '{1} au niveau {0}'
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703246
    m_Localized: "Sers {0} clients \xE0 {1}"
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703247
    m_Localized: "{0} paliers \xE0 {1}"
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703248
    m_Localized: "G\xE9rant de {1} niveau {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703249
    m_Localized: Tonton Modou
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703250
    m_Localized: "Mburu bu t\xE0ng, y\xE0pp wu t\xE0ng !"
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703251
    m_Localized: Badara le Baye Fall
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703252
    m_Localized: Kafe Tuubaa bi pare na.
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703253
    m_Localized: "Nd\xE8ye la reine de la nuit"
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703254
    m_Localized: Guddi gi ndaw la !
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703255
    m_Localized: Adja Fatou
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703256
    m_Localized: "Toogal, lekk, fii sa k\xEBr la."
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703257
    m_Localized: Oustaz Grill
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703258
    m_Localized: Le charbon chante, c'est bon signe.
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703259
    m_Localized: "A\xEFda Pastels"
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703260
    m_Localized: Un pour toi, un pour la route !
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703261
    m_Localized: Monsieur Teranga
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703262
    m_Localized: "Dalal ak j\xE0mm !"
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703263
    m_Localized: "M\xE8re Coumba la traiteuse"
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703264
    m_Localized: "Trois cents invit\xE9s ? Les marmites sont pr\xEAtes."
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703265
    m_Localized: "Pape du caf\xE9 Touba"
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703266
    m_Localized: "Une tasse et tu cours jusqu'\xE0 Rufisque !"
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703267
    m_Localized: Fatou Bissap
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703268
    m_Localized: Bissap bien frais pour aller avec ton sandwich !
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703269
    m_Localized: Ousmane le livreur en Jakarta
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703270
    m_Localized: "Livr\xE9 avant que \xE7a refroidisse, c'est promis."
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703271
    m_Localized: Yaye la Cheffe
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703272
    m_Localized: "Mon thi\xE9b', on en parle jusqu'\xE0 Saint-Louis."
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703273
    m_Localized: Le chauffeur de car rapide
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703274
    m_Localized: "Dernier arr\xEAt : les brochettes de Nd\xE8ye !"
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703275
    m_Localized: "Mame la commer\xE7ante de Sandaga"
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703276
    m_Localized: Le meilleur prix, pour le meilleur client.
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703277
    m_Localized: "Le Roi des ar\xE8nes"
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703278
    m_Localized: "Apr\xE8s le combat, tout le quartier mange chez nous !"
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703279
    m_Localized: La Grande Griotte
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703280
    m_Localized: Je chante ta maison, et toute la rue accourt.
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703281
    m_Localized: Tantie Alloco
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703282
    m_Localized: "Alloco bien dor\xE9, viens go\xFBter !"
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703283
    m_Localized: Le Boss du Garba
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703284
    m_Localized: "Garba-l\xE0, c'est le meilleur du quartier !"
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703285
    m_Localized: "Maman Atti\xE9k\xE9"
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703286
    m_Localized: "Atti\xE9k\xE9 tout frais, poisson bien brais\xE9."
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703287
    m_Localized: Maman Maquis
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703288
    m_Localized: Installe-toi, le maquis est ouvert !
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703289
    m_Localized: Le Roi du Choukouya
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703290
    m_Localized: La viande est tendre, la nuit est belle.
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703291
    m_Localized: Tonton Tchapalo
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703292
    m_Localized: "Une calebasse pour f\xEAter \xE7a ?"
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703293
    m_Localized: "Tantie K\xE9dj\xE9nou"
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703294
    m_Localized: Le canari mijote depuis ce matin.
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703295
    m_Localized: Monsieur Plateau
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703296
    m_Localized: "Table r\xE9serv\xE9e pour les grands patrons !"
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703297
    m_Localized: Le chauffeur de gbaka
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703298
    m_Localized: "Adjam\xE9\u2013Yopougon, garba compris !"
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703299
    m_Localized: Aya la vendeuse de jus
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703300
    m_Localized: "Gnamankoudji bien frais, \xE7a r\xE9veille !"
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703301
    m_Localized: Koffi le livreur
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703302
    m_Localized: Je connais toutes les rues de Cocody.
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703303
    m_Localized: La Reine du maquis
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703304
    m_Localized: Chez moi, on mange, on danse, on revient.
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703305
    m_Localized: Le chanteur de zouglou
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703306
    m_Localized: Une chanson pour chaque client !
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703307
    m_Localized: "Mamie W\xF4r\xF4-w\xF4r\xF4"
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703308
    m_Localized: "Mon taxi s'arr\xEAte toujours devant les bonnes adresses."
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703309
    m_Localized: "Le DJ coup\xE9-d\xE9cal\xE9"
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703310
    m_Localized: "Le son est lanc\xE9, la rue est en f\xEAte !"
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703311
    m_Localized: Le footballeur star
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703312
    m_Localized: "Apr\xE8s le match, tout le monde au choukouya !"
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703313
    m_Localized: "Mburu ak y\xE0pp (\xE0 valider)"
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703314
    m_Localized: "Le fourneau sur brouette s'installe au coin de la rue d\xE8s la
      tomb\xE9e du jour. On y glisse la viande grill\xE9e dans un pain encore chaud."
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703315
    m_Localized: Mariner la viande avec oignon, ail et poivre.
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703316
    m_Localized: Griller sur le charbon en retournant souvent.
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703317
    m_Localized: Ouvrir le pain et ajouter oignons et moutarde.
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703318
    m_Localized: Garnir de viande et servir chaud.
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703319
    m_Localized: "Omlet (\xE0 valider)"
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703320
    m_Localized: "Au tangana, l'omelette se commande dans un pain pour bien commencer
      la journ\xE9e. Chacun a son assaisonnement pr\xE9f\xE9r\xE9."
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703321
    m_Localized: "Battre les \u0153ufs avec sel et poivre."
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703322
    m_Localized: Faire revenir oignon et piment.
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703323
    m_Localized: "Cuire l'omelette \xE0 feu vif."
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703324
    m_Localized: Servir dans un pain.
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703325
    m_Localized: "Espageti (\xE0 valider)"
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703326
    m_Localized: "Le spaghetti en sandwich surprend les visiteurs mais r\xE9gale
      les habitu\xE9s. C'est un classique du petit-d\xE9jeuner de rue."
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703327
    m_Localized: "Cuire les p\xE2tes."
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703328
    m_Localized: "Pr\xE9parer une sauce tomate-oignon."
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703329
    m_Localized: "M\xE9langer p\xE2tes et sauce."
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703330
    m_Localized: Servir dans un pain.
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703331
    m_Localized: "\xD1ebbe (\xE0 valider)"
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703332
    m_Localized: "Le ni\xE9b\xE9 mijot\xE9 nourrit longtemps et co\xFBte peu. Il
      se mange souvent avec du pain au tangana."
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703333
    m_Localized: Faire tremper puis cuire les haricots.
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703334
    m_Localized: "Pr\xE9parer une sauce oignon-tomate."
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703335
    m_Localized: Laisser mijoter ensemble.
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703336
    m_Localized: Servir avec du pain.
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703337
    m_Localized: "Mburu ak toon (\xE0 valider)"
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703338
    m_Localized: "Rapide et pas cher, le pain-thon est le compagnon des matins press\xE9s.
      On l'agr\xE9mente souvent de mayonnaise et de piment."
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703339
    m_Localized: "\xC9mietter le thon."
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703340
    m_Localized: Ajouter oignon, mayonnaise et piment.
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703341
    m_Localized: Garnir le pain.
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703342
    m_Localized: "Makaroni (\xE0 valider)"
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703343
    m_Localized: "Les macaronis en sauce sont une autre star du tangana. On les sert
      parfois avec un \u0153uf."
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703344
    m_Localized: Cuire les macaronis.
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703345
    m_Localized: "Pr\xE9parer la sauce oignon-tomate."
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703346
    m_Localized: "M\xE9langer et servir."
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703347
    m_Localized: "Petipwa (\xE0 valider)"
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703348
    m_Localized: "Les petits pois en sauce garnissent le pain du matin. Un plat simple
      qui r\xE9chauffe."
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703349
    m_Localized: Faire revenir oignon et tomate.
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703350
    m_Localized: Ajouter les petits pois.
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703351
    m_Localized: Laisser mijoter et servir dans un pain.
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703352
    m_Localized: "Brosett (\xE0 valider)"
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703353
    m_Localized: "La nuit, les brochettes grillent sous l'ampoule du ma\xEFga. L'odeur
      attire tout le quartier."
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703354
    m_Localized: "Couper la viande en d\xE9s."
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703355
    m_Localized: "Mariner avec \xE9pices et oignon."
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703356
    m_Localized: Enfiler sur des pics.
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703357
    m_Localized: Griller sur le charbon.
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703358
    m_Localized: "Frit (\xE0 valider)"
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703359
    m_Localized: Les frites accompagnent les brochettes et l'omelette du soir. Croustillantes,
      elles partent vite.
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703360
    m_Localized: "\xC9plucher et couper les pommes de terre."
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703361
    m_Localized: "Frire une premi\xE8re fois."
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703362
    m_Localized: "Frire \xE0 nouveau plus chaud."
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703363
    m_Localized: Saler et servir.
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703364
    m_Localized: "Ceebu j\xEBn"
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703365
    m_Localized: "Riz au poisson et l\xE9gumes, le thi\xE9boudienne est souvent pr\xE9sent\xE9
      comme le plat national du S\xE9n\xE9gal. Le riz du fond de la marmite, croustillant,
      est tr\xE8s appr\xE9ci\xE9."
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703366
    m_Localized: "Farcir le poisson d'une p\xE2te de persil, ail et piment."
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703367
    m_Localized: "Faire revenir oignon et concentr\xE9 de tomate."
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703368
    m_Localized: "Cuire poisson et l\xE9gumes dans la sauce."
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703369
    m_Localized: Cuire le riz dans le bouillon.
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703370
    m_Localized: "Servir le riz avec poisson et l\xE9gumes."
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703371
    m_Localized: Yaasa
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703372
    m_Localized: "Le yassa marie le citron et les oignons confits. Il se d\xE9cline
      au poulet ou au poisson."
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703373
    m_Localized: Mariner le poulet avec citron, oignons et moutarde.
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703374
    m_Localized: Griller le poulet.
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703375
    m_Localized: Faire fondre les oignons de la marinade.
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703376
    m_Localized: Mijoter le poulet dans les oignons et servir avec du riz.
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703377
    m_Localized: Maafe
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703378
    m_Localized: "Le maf\xE9 est une sauce \xE0 base de p\xE2te d'arachide. Il est
      appr\xE9ci\xE9 dans toute l'Afrique de l'Ouest."
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703379
    m_Localized: Faire revenir la viande et l'oignon.
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703380
    m_Localized: "Ajouter tomate et p\xE2te d'arachide d\xE9lay\xE9e."
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703381
    m_Localized: "Mijoter avec les l\xE9gumes."
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703382
    m_Localized: Servir avec du riz.
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703383
    m_Localized: Dibi
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703384
    m_Localized: "\xC0 la dibiterie, l'agneau grill\xE9 se commande au poids. Il
      se partage avec oignons et moutarde."
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703385
    m_Localized: Couper l'agneau en morceaux.
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703386
    m_Localized: Griller au charbon.
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703387
    m_Localized: Assaisonner de sel et poivre.
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703388
    m_Localized: Servir avec oignons et moutarde.
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703389
    m_Localized: Fataya
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703390
    m_Localized: "Les fatayas sont des chaussons frits farcis. Ils se mangent avec
      une sauce tomate piment\xE9e."
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703391
    m_Localized: "Pr\xE9parer une p\xE2te souple."
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703392
    m_Localized: Garnir de viande ou de poisson.
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703393
    m_Localized: Fermer en chausson.
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703394
    m_Localized: "Frire jusqu'\xE0 dorure."
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703395
    m_Localized: "Nem (\xE0 valider)"
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703396
    m_Localized: "Les nems font partie des en-cas de f\xEAte au S\xE9n\xE9gal. Ils
      rappellent une histoire de rencontres entre cuisines."
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703397
    m_Localized: "Pr\xE9parer la farce."
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703398
    m_Localized: Rouler dans les galettes.
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703399
    m_Localized: Frire et servir chaud.
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703400
    m_Localized: Pastel
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703401
    m_Localized: "Les pastels sont de petits chaussons au poisson. Ils sont incontournables
      dans les f\xEAtes."
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703402
    m_Localized: "\xC9mietter le poisson avec oignon et piment."
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703403
    m_Localized: "Garnir de petits ronds de p\xE2te."
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703404
    m_Localized: Frire et servir avec sauce.
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703405
    m_Localized: "Supu k\xE0nja"
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703406
    m_Localized: "Le soupou kandja est une sauce au gombo tr\xE8s appr\xE9ci\xE9e.
      Elle se sert avec du riz blanc."
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703407
    m_Localized: Couper le gombo.
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703408
    m_Localized: Cuire viande et poisson.
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703409
    m_Localized: Ajouter gombo et huile de palme.
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703410
    m_Localized: Mijoter et servir avec du riz.
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703411
    m_Localized: "Kaldu (\xE0 valider)"
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703412
    m_Localized: "Le caldou est un poisson cuit dans un bouillon citronn\xE9. C'est
      un plat l\xE9ger et parfum\xE9."
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703413
    m_Localized: Faire revenir oignon et piment.
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703414
    m_Localized: Ajouter eau et citron.
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703415
    m_Localized: Pocher le poisson.
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703416
    m_Localized: Servir avec du riz.
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703417
    m_Localized: Caakiri
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703418
    m_Localized: "Le thiakry est un dessert de semoule de mil au lait caill\xE9.
      Il se sert bien frais."
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703419
    m_Localized: "Cuire la semoule de mil \xE0 la vapeur."
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703420
    m_Localized: "M\xE9langer avec lait caill\xE9 et sucre."
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703421
    m_Localized: Parfumer et servir frais.
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703422
    m_Localized: Cere
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703423
    m_Localized: "Le thi\xE9r\xE9, couscous de mil, accompagne de nombreuses f\xEAtes
      familiales. Il se sert avec une sauce \xE0 la viande."
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703424
    m_Localized: "Cuire la semoule de mil \xE0 la vapeur."
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703425
    m_Localized: "Pr\xE9parer une sauce \xE0 la viande."
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703426
    m_Localized: Servir ensemble.
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703427
    m_Localized: Ngalax
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703428
    m_Localized: "Le ngalakh est un dessert de mil \xE0 l'arachide et au pain de
      singe. Il se partage entre voisins lors des f\xEAtes."
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703429
    m_Localized: Cuire la semoule de mil.
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703430
    m_Localized: "Pr\xE9parer une cr\xE8me d'arachide et de pain de singe."
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703431
    m_Localized: "M\xE9langer et servir."
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703432
    m_Localized: "Mesuwi (\xE0 valider)"
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703433
    m_Localized: "Le mouton r\xF4ti entier est le roi des grandes f\xEAtes. Pr\xE9parer
      un m\xE9choui demande des heures de patience."
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703434
    m_Localized: Assaisonner le mouton.
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703435
    m_Localized: "R\xF4tir lentement sur le feu."
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703436
    m_Localized: "Arroser r\xE9guli\xE8rement."
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703437
    m_Localized: Servir avec oignons et frites.
    m_Metadata:
      m_Items: []
  - m_Id: 708215796703438
